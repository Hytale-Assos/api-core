# Non-secret runtime configuration for hytale-api-core.
# Copy on the deployment host to /home/hytale/hytale/env/api-core.env
# (the path referenced by hytale-api-core.container) and fill in the values.
#
# Sensitive values are podman secrets and never live in this file:
#   DATABASE_URL (embeds the password), ENCRYPTION_KEY, SEED_ADMIN_API_KEY,
#   SEED_ADMIN_HMAC_SECRET.
# See the provisioning commands in hytale-api-core.container.

# HTTP listen address. Unprivileged port inside the container, published by
# the host as 3000:3000.
BIND_ADDR=0.0.0.0:3000

# Log level (trace, debug, info, warn, error)
RUST_LOG=api_core=info,info

# Maximum request body size (bytes)
MAX_BODY_BYTES=1048576

# HMAC timestamp tolerance, in seconds (anti-replay protection)
HMAC_TOLERANCE_SECS=300

# Allowed CORS origins, comma-separated. The member website's origin.
CORS_ALLOWED_ORIGINS=https://example.org

# Queue worker delivering management commands to registered servers (ADR-0016)
QUEUE_POLL_SECS=5
QUEUE_BATCH_SIZE=20
QUEUE_MAX_ATTEMPTS=10
QUEUE_BACKOFF_SECS=2

# Name of the backoffice module created at startup (ADR-0012). Its key and
# HMAC secret come from the podman secrets; leave them empty files to seed
# nothing.
SEED_ADMIN_NAME=admin
