# syntax=docker/dockerfile:1

# Image versions, pinned by digest. Bump the tag and the digest together.
ARG RUST_IMAGE=rust:1.94-slim-bookworm@sha256:cf9dd0ec73e75f827fe59123fff9dc65af1a1c8363c3c31ee8d7f8ad0b6a5fb2
ARG RUNTIME_IMAGE=debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

# Release build with the pinned Rust toolchain.
# Migrations are embedded at compile time by sqlx::migrate!, so the runtime
# stage ships a single binary and needs no source tree, no toolchain, and no
# migrations/ directory.
FROM ${RUST_IMAGE} AS build

WORKDIR /build

# Cache the dependency build behind a stub binary: a Cargo.toml/Cargo.lock
# change still reuses the first pass; only source changes rebuild the second.
COPY Cargo.toml Cargo.lock ./
RUN mkdir src \
    && echo 'fn main() {}' > src/main.rs \
    && cargo build --release --locked \
    && rm -rf src target/release/deps/api_core*

COPY src ./src
COPY migrations ./migrations
RUN touch src/main.rs \
    && cargo build --release --locked

# Runtime: a single binary plus curl for the healthcheck, unprivileged.
# Never bake secrets or a .env into the image: the app reads plain
# environment variables.
FROM ${RUNTIME_IMAGE} AS runtime

ARG APP_USER=appuser

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home ${APP_USER}

COPY --from=build --chown=${APP_USER}:${APP_USER} /build/target/release/api-core /usr/local/bin/api-core

USER ${APP_USER}
WORKDIR /home/appuser

ENV BIND_ADDR=0.0.0.0:3000 \
    RUST_LOG=api_core=info,info

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -fsS http://127.0.0.1:3000/health || exit 1

ENTRYPOINT ["/usr/local/bin/api-core"]
