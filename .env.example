# Copier ce fichier vers `.env` et adapter les valeurs.

# Adresse d'écoute du serveur HTTP
BIND_ADDR=0.0.0.0:3000

# Connexion PostgreSQL (doit correspondre au docker-compose)
DATABASE_URL=postgres://api_core:api_core@localhost:5432/api_core

# Clé maître de chiffrement (base64, 32 octets = AES-256-GCM).
# Générer une fois avec : openssl rand -base64 32
# NE JAMAIS versionner la vraie valeur. Sa perte rend les données illisibles.
ENCRYPTION_KEY=

# Token statique protégeant les endpoints /api/v1/admin/*.
# Si vide, les routes d'administration sont désactivées.
ADMIN_TOKEN=

# Taille maximale du corps des requêtes (octets)
MAX_BODY_BYTES=1048576

# Tolérance sur l'horodatage HMAC, en secondes (protection anti-replay)
HMAC_TOLERANCE_SECS=300

# Origines CORS autorisées, séparées par des virgules ("*" pour tout autoriser)
CORS_ALLOWED_ORIGINS=*

# Niveau de log (trace, debug, info, warn, error)
RUST_LOG=api_core=debug,tower_http=debug,info
