# Copy this file to `.env` and adjust the values.

# HTTP listen address
BIND_ADDR=0.0.0.0:3000

# PostgreSQL connection (must match docker-compose)
DATABASE_URL=postgres://api_core:api_core@localhost:5432/api_core

# Encryption master key (base64, 32 bytes = AES-256-GCM).
# Generate once with: openssl rand -base64 32
# NEVER commit the real value. Losing it makes the data unreadable.
ENCRYPTION_KEY=

# --- Backoffice module seed ---
# Created at startup if it does not exist yet (idempotent). This module gets
# all scopes, including `admin` which bypasses ownership checks.
# Leave empty to seed nothing and create modules via `curl`.
SEED_ADMIN_API_KEY=
SEED_ADMIN_HMAC_SECRET=
SEED_ADMIN_NAME=admin

# Maximum request body size (bytes)
MAX_BODY_BYTES=1048576

# HMAC timestamp tolerance, in seconds (anti-replay protection)
HMAC_TOLERANCE_SECS=300

# Allowed CORS origins, comma-separated ("*" to allow all)
CORS_ALLOWED_ORIGINS=*

# Queue worker delivering management commands to registered servers (ADR-0016)
QUEUE_POLL_SECS=5
QUEUE_BATCH_SIZE=20
QUEUE_MAX_ATTEMPTS=10
QUEUE_BACKOFF_SECS=2

# Log level (trace, debug, info, warn, error)
RUST_LOG=api_core=debug,tower_http=debug,info
